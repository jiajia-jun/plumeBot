# PlumeBot 环境变量模板 —— 复制为 .env 使用：
#   cp .env.example .env
# .env 已被 .gitignore 忽略（本地文件，不会入库）；docker-compose 自动加载 .env 做 ${VAR} 插值。

# NapCat 登录 QQ 号（必须）。同时是 config.yaml 的 bot.self_id 的环境变量覆盖来源；
# docker-compose 的 ACCOUNT 优先取此值，未设置时退回下方 ACCOUNT。
PLUMEBOT_SELFID=

# NapCat WebUI 管理台密码（http://127.0.0.1:6099，可选；留空则 WebUI 无密码）
WEBUI_TOKEN=

# == 可选 ==
# NapCat ACCOUNT 兜底：仅当 PLUMEBOT_SELFID 未设置时生效
# ACCOUNT=